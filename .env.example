# Required: Sleeper league ID for your league
LEAGUE_ID=YOUR_CURRENT_LEAGUE_ID

# Optional but recommended for all-time records if Sleeper league history is not linked.
# Comma-separated list of prior league IDs, oldest-to-newest or newest-to-oldest both work.
HISTORICAL_LEAGUE_IDS=PAST_LEAGUE_ID_1,PAST_LEAGUE_ID_2,PAST_LEAGUE_ID_3

# Optional settings
PORT=3000
SLEEPER_BASE_URL=https://api.sleeper.app/v1
SLEEPER_CDN_BASE_URL=https://sleepercdn.com
